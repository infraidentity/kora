<%- include('partials/head') %>
<%
  var bestBuy = sells.length ? Math.min.apply(null, sells.map(function (o) { return o.rate_ngn; })) : null;
  var bestSell = buys.length ? Math.max.apply(null, buys.map(function (o) { return o.rate_ngn; })) : null;
  var people = {};
  sells.concat(buys).forEach(function (o) { if (o.verified) people[o.name] = 1; });
  var verifiedCount = Object.keys(people).length;
%>

<div class="page-head">
  <div>
    <span class="eyebrow"><%- icon('market') %> Market</span>
    <h1>Buy and sell USDC for naira</h1>
    <p>Every trader here has verified their identity with INFRA. Pick an offer to start a trade.</p>
  </div>
</div>

<div class="stats">
  <div class="stat">
    <span class="stat-label"><%- icon('arrow-down-left') %> Best price to buy</span>
    <span class="stat-value"><%= bestBuy ? ngn(bestBuy) : '—' %></span>
    <span class="subtle">per USDC</span>
  </div>
  <div class="stat">
    <span class="stat-label"><%- icon('arrow-up-right') %> Best price to sell</span>
    <span class="stat-value"><%= bestSell ? ngn(bestSell) : '—' %></span>
    <span class="subtle">per USDC</span>
  </div>
  <div class="stat">
    <span class="stat-label"><%- icon('users') %> Verified traders</span>
    <span class="stat-value"><%= verifiedCount %></span>
    <span class="subtle">with open offers</span>
  </div>
</div>

<%- include('partials/tier') %>

<div class="grid two" style="margin-top:16px">
  <% [['sell', 'Buy USDC', 'From people selling', sells, 'arrow-down-left'], ['buy', 'Sell USDC', 'To people buying', buys, 'arrow-up-right']].forEach(function (col) { %>
    <section class="card">
      <div class="card-head">
        <span class="card-icon <%= col[0] === 'sell' ? 'buy-tone' : 'sell-tone' %>"><%- icon(col[4]) %></span>
        <div>
          <h2><%= col[1] %></h2>
          <span class="subtle"><%= col[2] %> · <%= col[3].length %> offer<%= col[3].length === 1 ? '' : 's' %></span>
        </div>
      </div>
      <% if (!col[3].length) { %>
        <div class="empty"><%- icon('inbox') %><p>No offers yet.</p></div>
      <% } else { %>
        <ul class="offers">
          <% col[3].forEach(function (o) { var tn = traderName(o.name); %>
            <li class="offer" title="<%= o.name %>">
              <span class="avatar hue-<%= hue(o.name) %>" aria-hidden="true"><%= initials(o.name) %></span>
              <div>
                <div class="who-line">
                  <span><%= tn.first %></span>
                  <% if (tn.demo) { %><span class="pill">Demo</span><% } %>
                  <% if (o.verified) { %><span class="pill infra"><%- infraMark() %> Verified</span><% } else { %><span class="pill">Unverified</span><% } %>
                  <% if (o.merchant_name) { %><span class="pill brand" title="PayV merchant check: <%= o.merchant_name %>"><%- icon('badge') %> Merchant</span><% } %>
                  <% if (o.mine) { %><span class="pill">Yours</span><% } %>
                </div>
                <div class="numbers">Up to <strong><%= o.amount_usdc.toLocaleString('en-NG') %> USDC</strong></div>
              </div>
              <div class="offer-end">
                <span class="rate"><%= ngn(o.rate_ngn) %><small>per USDC</small></span>
                <% if (o.mine) { %>
                  <form method="post" action="/offers/<%= o.id %>/close" class="inline"><button class="btn small" type="submit"><%- icon('x') %> Close</button></form>
                <% } else { %>
                  <a class="btn small <%= tier.limitNgn ? 'primary' : '' %>" href="/offers/<%= o.id %>"><%= col[1] %> <%- icon('arrow-right') %></a>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
</div>

<div class="grid two" style="margin-top:16px">
  <section class="card">
    <div class="card-head">
      <span class="card-icon"><%- icon('plus') %></span>
      <div><h2>Post an offer</h2><span class="subtle">Other verified traders can take it</span></div>
    </div>
    <% if (!tier.limitNgn) { %>
      <div class="empty"><%- icon('lock') %><p>Posting opens once INFRA verifies you.</p></div>
    <% } else { %>
      <form method="post" action="/offers">
        <div class="fields">
          <div>
            <label for="side">I want to</label>
            <select id="side" name="side">
              <option value="sell">Sell USDC</option>
              <option value="buy">Buy USDC</option>
            </select>
          </div>
          <div>
            <label for="amount">Amount (USDC)</label>
            <input id="amount" name="amount_usdc" type="number" min="10" max="100000" step="1" required inputmode="numeric" placeholder="250">
          </div>
          <div>
            <label for="rate">Rate (₦ per USDC)</label>
            <input id="rate" name="rate_ngn" type="number" min="500" max="5000" step="1" required inputmode="numeric" placeholder="1605">
          </div>
        </div>
        <div class="spread" style="margin-top:14px">
          <span class="subtle">Your limit: <%= ngn(tier.limitNgn) %> per offer</span>
          <button class="btn primary" type="submit"><%- icon('plus') %> Post offer</button>
        </div>
      </form>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-icon"><%- icon('clock') %></span>
      <div><h2>Your trades</h2><span class="subtle">Trades you start or receive</span></div>
    </div>
    <% if (!trades.length) { %>
      <div class="empty"><%- icon('inbox') %><p>Nothing here yet. Take an offer to start your first trade.</p></div>
    <% } else { %>
      <ul class="offers">
        <% trades.forEach(function (t) { var other = t.maker_id ? (t.maker_first_name || 'Kora trader') : traderName(t.demo_name).first; %>
          <li class="offer">
            <span class="avatar <%= t.side === 'buy' ? 'buy-tone' : 'sell-tone' %>" aria-hidden="true"><%- icon(t.side === 'buy' ? 'arrow-down-left' : 'arrow-up-right') %></span>
            <div>
              <div class="who-line">#<%= t.id %> · <span class="side-<%= t.side %>"><%= t.side === 'buy' ? 'Buying' : 'Selling' %></span> <%= t.amount_usdc %> USDC</div>
              <div class="numbers"><%= ngn(t.total_ngn) %> · with <%= other %></div>
            </div>
            <div class="offer-end">
              <span class="pill <%= t.status === 'released' ? 'ok' : t.status === 'cancelled' ? 'bad' : 'warn' %>"><%= { open: 'Open', paid: 'Paid', released: 'Done', cancelled: 'Cancelled' }[t.status] %></span>
              <a class="btn small" href="/trades/<%= t.id %>">Open <%- icon('arrow-right') %></a>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('partials/foot') %>
