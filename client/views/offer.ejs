<%- include('partials/head') %>
<% const takerBuys = offer.side === 'sell'; %>

<a class="back" href="/market"><%- icon('arrow-left') %> Market</a>
<div class="page-head">
  <div class="row" style="gap:16px;align-items:center">
    <span class="avatar lg hue-<%= hue(offer.name) %>" aria-hidden="true"><%= initials(offer.name) %></span>
    <div>
      <h1><%= takerBuys ? 'Buy' : 'Sell' %> USDC <%= takerBuys ? 'from' : 'to' %> <%= offer.name %></h1>
      <p><span class="rate-inline"><%= price(offer.rate_usd) %></span> per USDC · up to <%= offer.amount_usdc.toLocaleString('en-US') %> USDC available</p>
    </div>
  </div>
</div>

<div class="grid two">
  <section class="card">
    <div class="card-head"><span class="card-icon <%= takerBuys ? 'buy-tone' : 'sell-tone' %>"><%- icon(takerBuys ? 'arrow-down-left' : 'arrow-up-right') %></span><div><h2>Start a trade</h2><span class="subtle">Your limit: <%= tier.limitUsd ? usd(tier.limitUsd) : 'not verified yet' %> per trade</span></div></div>
    <% if (!tier.limitUsd) { %>
      <p class="muted" style="margin-top:8px">Trading opens once INFRA verifies you. <%= next %></p>
    <% } else { %>
      <form method="post" action="/offers/<%= offer.id %>/trade" style="margin-top:14px" id="trade-form">
        <div class="field">
          <label for="amount">How much USDC?</label>
          <input id="amount" name="amount_usdc" type="number" min="1" max="<%= offer.amount_usdc %>" step="0.01" required inputmode="decimal" placeholder="100">
        </div>
        <p class="muted" style="margin-top:10px" id="total">You <%= takerBuys ? 'pay' : 'receive' %> — in dollars.</p>
        <p class="subtle" style="margin-top:4px">Your limit is <%= usd(tier.limitUsd) %> per trade.</p>
        <button class="btn primary block" type="submit" style="margin-top:14px"><%= takerBuys ? 'Buy' : 'Sell' %> USDC</button>
      </form>
      <script>
        (function () {
          var rate = <%= JSON.stringify(offer.rate_usd) %>;
          var input = document.getElementById('amount');
          var out = document.getElementById('total');
          var verb = <%- JSON.stringify(takerBuys ? 'pay' : 'receive') %>;
          input.addEventListener('input', function () {
            var n = Number(input.value) * rate;
            var cents = Math.round(n * 100) / 100;
            out.textContent = n > 0 ? 'You ' + verb + ' $' + cents.toLocaleString('en-US', { minimumFractionDigits: Number.isInteger(cents) ? 0 : 2, maximumFractionDigits: 2 }) + '.' : 'You ' + verb + ' — in dollars.';
          });
        })();
      </script>
    <% } %>
  </section>

  <section class="card stack">
    <div class="card-head"><span class="card-icon"><%- icon('id-card') %></span><div><h2>About <%= offer.name %></h2><span class="subtle">What INFRA confirms about this trader</span></div></div>
    <dl class="facts">
      <dt>Identity</dt>
      <dd><% if (!offer.user_id) { %>Demo trader (always available for testing)<% } else if (offer.kyc_status === 'verified') { %>Verified by INFRA<% } else { %>Not verified<% } %></dd>
      <% if (offer.country) { %><dt>Country</dt><dd><%= offer.country %></dd><% } %>
      <% if (offer.verified_at) { %><dt>Verified since</dt><dd><%= new Date(offer.verified_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) %></dd><% } %>
    </dl>
    <p class="subtle">Kora shows traders by first name only. Once the trade starts, you can ask them for an INFRA Connect code to see their full verified name before any money moves.</p>
  </section>
</div>

<%- include('partials/foot') %>
