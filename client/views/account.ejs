<%- include('partials/head') %>
<%
  var fullName = [user.first_name, user.last_name].filter(Boolean).join(' ') || 'Trader';
  var countryName = function (code) {
    if (!code) return null;
    try { return new Intl.DisplayNames(['en'], { type: 'region' }).of(String(code).toUpperCase()) || code; } catch (e) { return code; }
  };
  var day = function (d) { return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); };
  var titleCase = function (s) { s = String(s || '').replace(/_/g, ' '); return s.charAt(0).toUpperCase() + s.slice(1); };
  var SCOPE_TEXT = {
    'openid': 'Sign you in',
    'profile:read': 'Your name, country and username',
    'kyc:read': 'Whether INFRA verified you, and at what level',
    'claims:read': 'Facts INFRA confirmed, like "Over 18"',
    'documents:metadata': 'Which IDs you verified (never the documents)',
    'phone:read': 'Your phone number',
    'proof:age_over_18': 'Proof that you are over 18', 'proof:age_over_21': 'Proof that you are over 21',
    'proof:kyc_verified': 'Proof that you are verified', 'proof:unique_human': 'Proof that you are one real person',
    'proof:phone_verified': 'Proof that your phone is confirmed', 'proof:address_verified': 'Proof that your address is confirmed',
    'proof:watchlist_clear': 'Proof that you passed the safety check', 'proof:resident_country': 'Proof of your country',
    'proof:resident_state': 'Proof of your state', 'proof:postal_region': 'Proof of your postal area',
    'offline_access': 'Stay up to date while you are away',
  };
  var levelText = user.kyc_level ? user.kyc_level.replace('level_', 'Level ') : null;
%>

<div class="page-head">
  <div>
    <span class="eyebrow"><%- icon('user') %> Your details</span>
    <h1>What INFRA shared with Kora</h1>
    <p>This is everything INFRA shared with Kora when you signed in. Kora keeps it up to date and deletes it the moment you withdraw access.</p>
  </div>
  <form method="post" action="/refresh" class="inline"><button class="btn" type="submit"><%- icon('refresh') %> Refresh from INFRA</button></form>
</div>

<section class="card profile-card">
  <div class="profile-main">
    <span class="avatar xl hue-<%= hue(fullName) %>" aria-hidden="true"><%= initials(fullName) %></span>
    <div class="profile-id">
      <h2><%= fullName %></h2>
      <div class="row" style="gap:8px;margin-top:6px">
        <% if (user.username) { %>
          <% if (String(user.profile_url || '').startsWith('https://')) { %><a class="handle" href="<%= user.profile_url %>" target="_blank" rel="noopener">@<%= user.username %> <%- icon('external') %></a><% } else { %><span class="handle">@<%= user.username %></span><% } %>
        <% } else { %><span class="subtle">INFRA username not set</span><% } %>
        <% if (user.kyc_status === 'verified') { %>
          <span class="pill infra"><%- infraMark() %> Verified<%= levelText ? ' · ' + levelText : '' %></span>
        <% } else { %>
          <span class="pill <%= user.kyc_status === 'pending' ? 'warn' : user.kyc_status === 'not_started' ? '' : 'bad' %>"><%= titleCase(user.kyc_status) %><%= levelText ? ' · ' + levelText : '' %></span>
        <% } %>
        <span class="pill brand"><%= tier.name %> trader</span>
      </div>
      <% if (user.verified_at) { %><p class="subtle" style="margin-top:8px">Verified by INFRA on <%= day(user.verified_at) %></p><% } %>
    </div>
  </div>
  <ul class="info-list">
    <li><span class="info-icon"><%- icon('inbox') %></span><span class="info-label">Email</span><span class="info-value"><%= user.email || '—' %></span></li>
    <li><span class="info-icon"><%- icon('phone') %></span><span class="info-label">Phone</span>
      <span class="info-value">
        <% if (user.phone && user.phone.number) { %>
          <span class="mono"><%= user.phone.number %></span>
          <% if (user.phone.verified) { %><span class="pill infra"><%- infraMark() %> Confirmed by INFRA</span><% } else { %><span class="pill">Not confirmed</span><% } %>
        <% } else { %><span class="muted">Not shared</span><% } %>
      </span>
    </li>
    <li><span class="info-icon"><%- icon('market') %></span><span class="info-label">Country</span><span class="info-value"><%= countryName(user.country) || '—' %></span></li>
  </ul>
</section>

<div class="grid two" style="margin-top:16px">
  <section class="card stack">
    <div class="card-head"><span class="card-icon"><%- icon('seal') %></span><div><h2>What INFRA has confirmed</h2><span class="subtle">Facts, not documents</span></div></div>
    <% if (!user.claims.length) { %>
      <div class="empty"><%- icon('seal') %><p>Nothing yet. Confirmed facts (like "Over 18") appear here after INFRA verifies you.</p></div>
    <% } else { %>
      <ul class="facts-grid">
        <% user.claims.forEach(function (c) { %>
          <li>
            <span class="fact-tick"><%- icon('check') %></span>
            <span>
              <strong><%= claimLabels[c.claim_type] || titleCase(c.claim_type) %><%= c.value && c.value.country ? ': ' + (countryName(c.value.country) || c.value.country) : '' %></strong>
              <span class="subtle"><%= c.expires_at ? 'Until ' + new Date(c.expires_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'No end date' %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% var cc = user.credentialCheck; %>
    <% if (cc && cc.ok) { %>
      <p class="notice ok signed" style="margin:0"><%- infraMark() %> Signed by INFRA
        <span class="subtle" style="display:block;font-weight:400;margin-top:2px">Kora checked these facts against INFRA's public key (<span class="mono"><%= cc.kid %></span>)<%= cc.environment === 'test' ? ' · test user' : ' · live account' %>. <%= cc.facts.length %> signed fact<%= cc.facts.length === 1 ? '' : 's' %>.</span>
      </p>
    <% } else if (cc) { %>
      <p class="notice error" style="margin:0">INFRA's signature didn't check out: <%= cc.reason %> Kora doesn't rely on these facts.</p>
    <% } else if (user.claims.length) { %>
      <p class="subtle">INFRA didn't send a signed copy of these facts.</p>
    <% } %>
  </section>

  <section class="card stack">
    <div class="card-head"><span class="card-icon"><%- icon('id-card') %></span><div><h2>Documents you verified</h2><span class="subtle">Kora sees the type and status only, never the document</span></div></div>
    <% if (!user.documents.length) { %>
      <div class="empty"><%- icon('file') %><p>None shared.</p></div>
    <% } else { %>
      <ul class="doc-list">
        <% user.documents.forEach(function (d) { %>
          <li title="<%= d.document_type %>">
            <span class="info-icon"><%- icon('file') %></span>
            <span class="doc-name"><%= titleCase(d.document_type || 'Document') %><span class="subtle"><%= d.expiry_date ? 'Expires ' + new Date(d.expiry_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'No expiry date' %></span></span>
            <span class="pill <%= d.status === 'verified' ? 'ok' : d.status === 'expired' || d.status === 'rejected' ? 'bad' : 'warn' %>"><%= titleCase(d.status) %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('partials/tier') %>

<section class="card stack zk-card" style="margin-top:16px" id="zk-demo">
  <div class="card-head"><span class="card-icon"><%- icon('seal') %></span><div><h2>Prove it with INFRA</h2><span class="subtle">The answer, not the data</span></div></div>
  <p class="muted">Kora asks INFRA to <strong>prove</strong> each fact about you, one at a time. For each one Kora gets a proof that says yes (or one short detail, like your country), and nothing else: not your birthday, not your ID, not your address. Each proof only works for Kora, right now.</p>
  <div class="row">
    <button class="btn primary" type="button" id="zk-run"><%- infraMark('light') %> Prove my facts</button>
    <span class="subtle" id="zk-status" role="status" aria-live="polite"></span>
  </div>
  <div id="zk-result" hidden>
    <ul class="facts-grid" id="zk-facts"></ul>
    <ul class="access-list" id="zk-details" style="margin-top:12px"></ul>
  </div>
</section>
<script>
  (function () {
    var btn = document.getElementById('zk-run');
    var status = document.getElementById('zk-status');
    var box = document.getElementById('zk-result');
    var factsEl = document.getElementById('zk-facts');
    var detailsEl = document.getElementById('zk-details');
    var LABELS = {
      age_over_18: 'Over 18', age_over_21: 'Over 21', kyc_verified: 'Verified by INFRA',
      unique_human: 'One real person', phone_verified: 'Phone confirmed', address_verified: 'Address confirmed',
      watchlist_clear: 'Passed the safety check', resident_country: 'Country', resident_state: 'State', postal_region: 'Postal area'
    };
    var STATUS = { not_confirmed: 'Not confirmed for you yet', no_permission: 'No permission given', failed: 'Could not prove', off: 'Proofs are off' };
    function esc(t) { var d = document.createElement('div'); d.textContent = String(t); return d.innerHTML; }
    function li(html) { var el = document.createElement('li'); el.innerHTML = html; return el; }
    var tick = '<span class="fact-tick"><%- icon('check') %></span>';
    var dash = '<span class="fact-tick" style="background:var(--line, #ccc)">–</span>';
    var bad = '<span class="fact-tick" style="background:var(--bad)">!</span>';
    btn.addEventListener('click', function () {
      btn.disabled = true; status.textContent = 'Asking INFRA for proofs… (about 5 seconds)'; box.hidden = true;
      fetch('/zk/demo', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          btn.disabled = false;
          if (!d.results) { status.textContent = d.message || 'Something went wrong.'; return; }
          var proven = d.results.filter(function (r) { return r.status === 'proven'; });
          status.textContent = proven.length + ' of ' + d.results.length + ' facts proven and checked.';
          factsEl.innerHTML = ''; detailsEl.innerHTML = '';
          d.results.forEach(function (r) {
            var mark = r.status === 'proven' ? tick : (r.status === 'failed' ? bad : dash);
            var text = r.status === 'proven' ? (r.value === true ? 'Yes' : esc(r.value)) + ' · ' + ((r.prove_ms + r.verify_ms) / 1000).toFixed(1) + ' s' : STATUS[r.status] || r.status;
            factsEl.appendChild(li(mark + '<span><strong>' + (LABELS[r.fact] || esc(r.fact)) + '</strong><span class="subtle">' + text + '</span></span>'));
          });
          detailsEl.appendChild(li(tick + '<span>Kora never saw your birthday, ID, phone number or address</span>'));
          if (proven.length) {
            var p = proven[0];
            detailsEl.appendChild(li(tick + '<span>Each proof is about ' + p.proof_kb + ' KB and is made in about ' + (p.prove_ms / 1000).toFixed(1) + ' s</span>'));
          }
          if (d.copied_proof_refused !== null) {
            detailsEl.appendChild(li((d.copied_proof_refused ? tick : bad) + '<span>' + (d.copied_proof_refused ? 'A proof copied to another session was refused' : 'Warning: a copied proof was not refused') + '</span>'));
          }
          if (d.results.some(function (r) { return r.status === 'no_permission'; })) {
            detailsEl.appendChild(li(dash + '<span>To prove the rest, sign out, sign in again and allow "Prove facts about you"</span>'));
          }
          box.hidden = false;
        })
        .catch(function () { btn.disabled = false; status.textContent = 'INFRA is unreachable right now.'; });
    });
  })();
</script>

<section class="card stack" style="margin-top:16px" id="infra-events">
  <div class="card-head"><span class="card-icon"><%- icon('bell') %></span><div><h2>What INFRA told Kora</h2><span class="subtle">INFRA tells Kora when something about your verification changes. Here is what it said, and what Kora did.</span></div></div>
  <% if (!(user.alerts || []).length) { %>
    <div class="empty"><%- icon('bell') %><p>Nothing yet.</p></div>
  <% } else { %>
    <ol class="timeline">
      <% user.alerts.forEach(function (a) { %>
        <li class="tone-<%= a.tone === 'bad' ? 'bad' : a.tone %>">
          <p><%= a.text %></p>
          <span class="subtle"><%= new Date(a.at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %><%= a.simulated ? ' · test event' : '' %></span>
        </li>
      <% }) %>
    </ol>
  <% } %>
</section>

<div class="grid two" style="margin-top:16px">
  <section class="card stack">
    <div class="card-head"><span class="card-icon"><%- icon('key') %></span><div><h2>Access you gave Kora</h2><span class="subtle">You can take it back any time</span></div></div>
    <% if (scopes.length) { %>
      <ul class="access-list">
        <% scopes.forEach(function (s) { %>
          <li><span class="fact-tick"><%- icon('check') %></span><span><%= SCOPE_TEXT[s] || s %><code><%= s %></code></span></li>
        <% }) %>
      </ul>
    <% } %>
    <p class="muted">To stop sharing, open INFRA Accounts → Connected apps and remove Kora. INFRA tells Kora straight away and Kora deletes your data and signs you out.</p>
    <a class="btn" href="<%= accountsUrl %>" target="_blank" rel="noopener"><%- infraMark() %> Manage in INFRA Accounts</a>
  </section>

  <section class="card stack danger-zone">
    <div class="card-head"><span class="card-icon bad-tone"><%- icon('trash') %></span><div><h2>Delete your Kora data</h2><span class="subtle">Your INFRA account stays as it is</span></div></div>
    <p class="muted">Removes your profile, offers, trades and checks from Kora. Your INFRA account and verification are not affected.</p>
    <form method="post" action="/account/delete" onsubmit="return confirm('Delete everything Kora holds about you?')">
      <button class="btn danger" type="submit"><%- icon('trash') %> Delete my Kora data</button>
    </form>
  </section>
</div>

<%- include('partials/foot') %>
