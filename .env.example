# ============================================================================
# KORA (INFRA test app): environment variables
# Copy to .env and fill in. See README.md for where each value comes from.
# ============================================================================

NODE_ENV=development
PORT=3002
# Long random string; signs the session cookie.
SESSION_SECRET=change-me-to-64-random-characters
# Where Kora keeps its SQLite file (default: ./data/kora.db).
# DB_PATH=./data/kora.db

# ── INFRA endpoints ─────────────────────────────────────────────────────────
INFRA_API_BASE_URL=https://api.infraidentity.com
# "iss" INFRA puts on signed results (CLAIM_CREDENTIAL_ISSUER on api_server).
INFRA_ISSUER=https://api.infraidentity.com
INFRA_ACCOUNTS_URL=https://accounts.infraidentity.com
HYDRA_AUTH_URL=https://oauth.infraidentity.com/oauth2/auth
HYDRA_TOKEN_URL=https://oauth.infraidentity.com/oauth2/token

# ── App 1: "Kora" (subscription billing): sign-in + INFRA Connect ───────────
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3002/callback
SCOPES=profile:read kyc:read claims:read documents:metadata offline_access proof:age_over_18 proof:age_over_21 proof:kyc_verified proof:unique_human proof:phone_verified proof:address_verified proof:watchlist_clear proof:resident_country proof:resident_state proof:postal_region
# Asked for too; sign-in still works if Kora's app on INFRA doesn't allow them yet.
OPTIONAL_SCOPES=phone:read

# Webhook signing secret: the same value you give INFRA when registering the
# webhook (scripts/register-webhooks.js). Also signs deletion callbacks.
WEBHOOK_SECRET=
# Public https URL of this Kora (used by scripts/register-webhooks.js).
KORA_PUBLIC_URL=

# ── PayV (merchant badge): the SAME app, with Pay-As-You-Verify switched on ─
# Optional. Empty = use CLIENT_ID / CLIENT_SECRET. Until INFRA opens live
# PayV payments, every payment settles on Base Sepolia with test USDC.
PAYV_CLIENT_ID=
PAYV_CLIENT_SECRET=

# ── Developer panel (/dev) ──────────────────────────────────────────────────
# Required to open /dev in production: visit /dev?key=<this>.
DEV_PANEL_KEY=
